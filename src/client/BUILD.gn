import("//build/template/protobuf.gni")

source_set("client") {
  sources = [
    "autostart.cc",
    "autostart.h",
    "clang.cc",
    "clang.h",
    "driver_name.cc",
    "driver_name.h",
  ]

  deps = [
    ":config_proto",
    "//src/base:base",
    "//src/base:logging",
    "//src/net:net",
    "//src/net:net_proto",
    "//src/perf:stat_proto",
  ]
}

source_set("configuration") {
  sources = [
    "configuration.cc",
    "configuration.hh",
  ]

  deps = [
    "//src/base:base",
    "//src/base:logging",
  ]

  public_deps = [ ":config_proto" ]
}

protobuf("config_proto") {
  deps = [ "//src/base:base_proto" ]

  sources = [ "configuration.proto" ]
}
