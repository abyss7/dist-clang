import("//build/template/protobuf.gni")

static_library("net") {
  sources = [
    "connection.cc",
    "connection.h",
    "connection_forward.h",
    "connection_impl.cc",
    "connection_impl.h",
    "end_point.cc",
    "end_point.h",
    "end_point_resolver.cc",
    "end_point_resolver.h",
    "event_loop.cc",
    "event_loop.h",
    "event_loop_linux.cc",
    "event_loop_linux.h",
    "event_loop_mac.cc",
    "event_loop_mac.h",
    "network_service.h",
    "network_service_impl.cc",
    "network_service_impl.h",
    "network_service_linux.cc",
    "network_service_mac.cc",
    "passive.cc",
    "passive.h",
    "passive_linux.cc",
    "passive_mac.cc",
    "socket.cc",
    "socket.h",
  ]
  sources -= filter_include(sources, platform_sources_filter)

  deps = [
    ":net_proto",
    "//src/base:base",
    "//src/base:logging",
    "//src/perf:counter",
  ]
}

protobuf("net_proto") {
  deps = [
    "//src/base:base_proto",
    "//src/daemon:config_proto",
    "//src/daemon:remote_proto",
    "//src/perf:stat_proto",
  ]
  sources = [ "universal.proto" ]
}
