config("includes") {
  include_dirs = [
    "exported/googletest/include",
    "exported/googlemock/include",
  ]
}

static_library("gtest") {
  testonly = true

  sources = [
    "exported/googlemock/src/gmock-all.cc",
    "exported/googletest/src/gtest-all.cc",
  ]

  include_dirs = [
    "exported/googletest",
    "exported/googlemock",
  ]

  configs += [ "//build/config:third_party" ]
  public_configs = [ ":includes" ]
}

# Only |gtest_prod.h| for |FRIEND_TEST| in non-test code.
source_set("prod") {
  public = [ "exported/googletest/include/gtest/gtest_prod.h" ]
  public_configs = [ ":includes" ]
}
