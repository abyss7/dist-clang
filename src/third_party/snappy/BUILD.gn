config("includes") {
  include_dirs = [
    "exported",
    "config",
  ]
}

config("flags") {
  defines = [ "HAVE_CONFIG_H=1" ]
}

static_library("snappy") {
  sources = [
    "config/config.h",
    "config/snappy-stubs-public.h",
    "exported/snappy-c.cc",
    "exported/snappy-c.h",
    "exported/snappy-internal.h",
    "exported/snappy-sinksource.cc",
    "exported/snappy-sinksource.h",
    "exported/snappy-stubs-internal.cc",
    "exported/snappy-stubs-internal.h",
    "exported/snappy.cc",
    "exported/snappy.h",
  ]

  public = [ "exported/snappy.h" ]

  configs += [
    ":flags",
    "//build/config:third_party",
  ]
  public_configs = [ ":includes" ]
}
