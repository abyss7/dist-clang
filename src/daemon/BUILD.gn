import("//build/template/protobuf.gni")

executable("dist-clangd") {
  sources = [ "daemon_main.cc" ]

  deps = [
    ":configuration",
    ":daemon",
    "//src/base:base",
    "//src/base:logging",
  ]
}

# Separate source set for unit-tests.
source_set("daemon") {
  sources = [
    "absorber.cc",
    "absorber.h",
    "base_daemon.cc",
    "base_daemon.h",
    "collector.cc",
    "collector.h",
    "compilation_daemon.cc",
    "compilation_daemon.h",
    "compiler_identity.cc",
    "compiler_identity.h",
    "coordinator.cc",
    "coordinator.h",
    "driver_args.cc",
    "driver_args.h",
    "emitter.cc",
    "emitter.h",
    "outputs.cc",
    "outputs.h",
  ]

  deps = [
    ":remote_proto",
    "//src/base:base",
    "//src/base:logging",
    "//src/cache:file_cache",
    "//src/net:net",
    "//src/perf:counter",
    "//src/perf:stat_service",
  ]

  public_deps = [
    ":configuration",
    "//src/third_party/gtest:prod",
  ]
}

source_set("configuration") {
  sources = [
    "configuration.cc",
    "configuration.h",
  ]

  configs += [ "//build/config:version" ]

  deps = [
    ":config_proto",
    "//src/base:base",
    "//src/base:logging",
  ]
}

protobuf("config_proto") {
  deps = [ "//src/base:base_proto" ]
  sources = [ "configuration.proto" ]
}

protobuf("remote_proto") {
  deps = [
    "//src/base:base_proto",
    "//src/net:net_proto",
  ]
  sources = [ "remote.proto" ]
}
