import("//build/template/protobuf.gni")

source_set("sqlite") {
  sources = [
    "sqlite3.c",
    "sqlite3.h",
  ]

  configs += [ "//build/config:third_party" ]
}

static_library("file_cache") {
  sources = [
    "blob_store.cc",
    "blob_store.h",
    "compression.cc",
    "compression.h",
    "database.h",
    "database_kv.cc",
    "database_kv.h",
    "database_sqlite.cc",
    "database_sqlite.h",
    "database_sqlite_migrator.cc",
    "file_cache.cc",
    "file_cache.h",
    "file_cache_migrator.cc",
    "file_hash_cache.cc",
    "file_hash_cache.h",
    "sqlite_utils.cc",
    "sqlite_utils.h",
    "tag_index.cc",
    "tag_index.h",
  ]

  public = [ "file_cache.h" ]

  deps = [
    ":sqlite",
    "//src/base:base",
    "//src/base:logging",
    "//src/perf:stat_service",
    "//src/third_party/snappy:snappy",
    "//src/third_party/zstd:zstd",
  ]

  public_deps = [
    ":manifest_proto",  # for file_cache_migrator_test.cc
    "//src/third_party/gtest:prod",
  ]
}

protobuf("manifest_proto") {
  sources = [ "manifest.proto" ]
}
