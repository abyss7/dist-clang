# systemd user unit - an alternative to the autostart by the client:
#   cp dist-clangd.service ~/.config/systemd/user/
#   systemctl --user enable --now dist-clangd
#
# The daemon doesn't stop on "dist-clang --stop": use
#   systemctl --user stop dist-clangd
# or "systemctl --user restart dist-clangd" to apply a new configuration.

[Unit]
Description=dist-clang local compilation daemon

[Service]
ExecStart=%h/.local/bin/dist-clangd --config=%h/.config/dist-clang/daemon.conf --managed
Nice=0

[Install]
WantedBy=default.target
