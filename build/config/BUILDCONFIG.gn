# =============================================================================
# Command-line arguments, with default values.
# =============================================================================

declare_args() {
  # Build for debugging.
  config_for_debug = false

  # Build for testing.
  config_for_tests = false

  # Build version.
  version = exec_script("//build/version.py", [], "string")

  # Use Clang ASan.
  use_asan = false

  # Use Clang TSan.
  use_tsan = false

  # Compilers used to build the project itself, e.g. "clang-18".
  clang_cc = "clang"
  clang_cxx = "clang++"
}

assert(!(use_asan && use_tsan), "Use either ASan or TSan at the same time")

# =============================================================================
# Setup configurations.
# =============================================================================

default_configs = [
  "//build/config:asan",
  "//build/config:base",
  "//build/config:tsan",
]

if (host_os == "mac") {
  default_configs += [ "//build/config/mac:compatibility" ]
}

if (config_for_tests) {
  if (!use_tsan) {
    use_asan = true
    if (host_os == "mac") {
      # FIXME: ASan binaries doesn't run on Mac
      use_asan = false
    }
  }

  default_configs += [ "//build/config:debug" ]
} else {
  default_configs += [
    "//build/config:no_exceptions",
    "//build/config:no_rtti",
  ]

  if (config_for_debug) {
    default_configs += [ "//build/config:debug" ]
  } else {
    default_configs += [ "//build/config:release" ]
  }
}

if (host_os == "linux") {
  default_configs += [ "//build/config/linux:base" ]
}
if (host_os == "mac") {
  default_configs += [ "//build/config/mac:base" ]
}
if (host_os == "win") {
  default_configs += [ "//build/config/win:base" ]
}

# =============================================================================
# Set defaults.
# =============================================================================

set_defaults("executable") {
  configs = default_configs
}

set_defaults("shared_library") {
  configs = default_configs
}

set_defaults("source_set") {
  configs = default_configs
}

set_defaults("static_library") {
  configs = default_configs
}

# =============================================================================
# Platform-specific sources.
#
# Usage: sources -= filter_include(sources, platform_sources_filter)
# =============================================================================

platform_sources_filter = []
if (host_os != "mac") {
  platform_sources_filter += [
    "*_mac.h",
    "*_mac.cc",
    "*_mac_test.cc",
  ]
}
if (host_os != "linux") {
  platform_sources_filter += [
    "*_linux.h",
    "*_linux.cc",
    "*_linux_test.cc",
  ]
}
if (host_os != "mac" && host_os != "linux") {
  platform_sources_filter += [
    "*_posix.h",
    "*_posix.cc",
    "*_posix_test.cc",
  ]
}
if (host_os != "win") {
  platform_sources_filter += [
    "*_win.h",
    "*_win.cc",
    "*_win_test.cc",
  ]
}

# =============================================================================
# Setup toolchain.
# =============================================================================

if (host_os == "linux") {
  set_default_toolchain("//build/toolchain/linux:clang")
}
if (host_os == "mac") {
  set_default_toolchain("//build/toolchain/mac:clang")
}
if (host_os == "win") {
  set_default_toolchain("//build/toolchain/win:clang")
}
