config("base") {
  cflags = [
    "-fPIC",
    "-pipe",
    "-pthread",
    "-Wall",
    "-Wextra",
    "-Woverloaded-virtual",
    "-Wsign-compare",
    "-Wwrite-strings",
    "-Wno-unknown-warning-option",
    "-Wno-unused-parameter",
    "-Wno-missing-field-initializers",
    "-Werror",
  ]

  cflags_cc = [ "-std=c++20" ]

  include_dirs = [
    "//src",
    "$root_gen_dir/src",
  ]

  ldflags = [ "-pthread" ]
}

# Third-party code isn't ours to fix: keep the warnings, but don't fail on them.
config("third_party") {
  cflags = [
    "-Wno-error",
    "-w",
  ]
}

config("debug") {
  cflags = [
    "-g",
    "-O0",
  ]

  defines = [ "_DEBUG" ]
}

config("release") {
  cflags = [
    "-fomit-frame-pointer",
    "-O2",
  ]

  defines = [ "NDEBUG" ]
}

config("no_exceptions") {
  cflags_cc = [ "-fno-exceptions" ]
  ldflags = [ "-fno-exceptions" ]

  if (host_os == "win") {
    defines = [ "_HAS_EXCEPTIONS=0" ]
  }
}

config("no_rtti") {
  cflags_cc = [ "-fno-rtti" ]
  ldflags = [ "-fno-rtti" ]
}

config("version") {
  defines = [ "VERSION=\"$version\"" ]
}

config("asan") {
  if (use_asan) {
    cflags = [
      "-fsanitize=address",
      "-fno-omit-frame-pointer",
    ]

    ldflags = [ "-fsanitize=address" ]
  }
}

config("tsan") {
  if (use_tsan) {
    cflags = [ "-fsanitize=thread" ]
    ldflags = [ "-fsanitize=thread" ]
  }
}
