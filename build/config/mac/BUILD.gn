config("base") {
  defines = [ "OS_MACOSX" ]

  # The names of the architectures for "-arch".
  if (host_cpu == "arm64") {
    arch = "arm64"
  } else {
    arch = "x86_64"
  }

  cflags = [
    "-arch",
    arch,
  ]
  ldflags = [
    "-arch",
    arch,
    "-rpath",
    "@loader_path/.",

    # FIXME: don't use this flag because of silly Protobuf extensions.
    # "-undefined",
    # "error",
  ]
}

# The oldest macOS on Apple Silicon.
config("compatibility") {
  cflags = [ "-mmacosx-version-min=11.0" ]
  ldflags = [ "-mmacosx-version-min=11.0" ]
}
