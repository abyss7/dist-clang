#!/usr/bin/env bash
# Usage: build/configure [gn args...], e.g.
#   build/configure 'clang_cc="clang-18"' 'clang_cxx="clang++-18"'

set -e

cd "$(dirname "$0")/.."

gn gen --check --args="config_for_debug=true $*" out/Debug
gn gen --check --args="$*" out/Release
gn gen --check --args="config_for_tests=true $*" out/Test
