#!/usr/bin/env bash
# Usage: build/smoke_test [compiler]
#
# Compiles a source through the daemon of the release build in a scratch
# environment, until it's found in the direct cache: the real compiler of the
# platform is used - not the fakes of the unit tests.

set -euo pipefail

cd "$(dirname "$0")/.."
# The client starts the daemon next to it.
dc="${DC:-$PWD/out/Release/dist-clang}"
cxx="${1:-clang++}"

work="$(mktemp -d)"
export XDG_RUNTIME_DIR="$work/run" XDG_CACHE_HOME="$work/cache" \
       XDG_CONFIG_HOME="$work/config"
mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CACHE_HOME" "$XDG_CONFIG_HOME"

# Only the daemon of this environment is stopped.
stop_daemon() {
  local pids
  pids="$(lsof -t "$XDG_RUNTIME_DIR/dist-clang.socket" 2>/dev/null || true)"
  [ -n "$pids" ] && kill $pids 2>/dev/null || true
  rm -rf "$work"
}
trap stop_daemon EXIT

cd "$work"
cat > test.cc <<'SOURCE'
#include <string>
int main() { return std::string("smoke").size() == 5 ? 0 : 1; }
SOURCE

compile() {
  "$dc" "$cxx" -c test.cc -o "test$1.o" -MD -MF "test$1.d"
}

stat_value() {
  "$dc" --stats --raw 2>/dev/null | awk -v name="$1" '$1 == name { print $2 }'
}

# The first compilation may run locally, while the daemon starts.
hit=
for i in 1 2 3 4 5; do
  compile $i
  if [ "$(stat_value DIRECT_CACHE_HIT)" -ge 1 ] 2>/dev/null; then
    cmp "test$((i - 1)).o" "test$i.o"
    "$cxx" test$i.o -o test && ./test
    echo "The compilation $i is found in the direct cache"
    hit=1
    break
  fi
  sleep 1
done
if [ -z "$hit" ]; then
  "$dc" --stats || true
  echo "No hits of the direct cache" >&2
  exit 1
fi

# A system header changes: "-MMD" leaves it out of the dependency file, but
# the cache must not return the old object.
mkdir -p system
cat > system_header.cc <<'SOURCE'
#include <value.h>
int main() { return VALUE; }
SOURCE
for value in 1 2 3; do
  echo "#define VALUE $value" > system/value.h
  rm -f system_header.o
  "$dc" "$cxx" -isystem system -c system_header.cc -o system_header.o -MMD
  "$cxx" system_header.o -o system_header
  ./system_header && result=0 || result=$?
  if [ "$result" != "$value" ]; then
    echo "The system header with the value $value gives $result" >&2
    exit 1
  fi
done
echo "The changes of the system headers are seen"

# A new file in an include directory shadows a system header from the
# implicit directories of the compiler: the cache must not return the old
# object.
mkdir -p compat
cat > shadowed.cc <<'SOURCE'
#include <stdio.h>
int main() { return 0; }
SOURCE
for i in 1 2; do
  rm -f shadowed.o
  "$dc" "$cxx" -Icompat -c shadowed.cc -o shadowed.o -MD
done
echo '#error The shadowing header is used' > compat/stdio.h
if "$dc" "$cxx" -Icompat -c shadowed.cc -o shadowed.o -MD 2>/dev/null; then
  echo "The header, that shadows a system one, isn't seen" >&2
  exit 1
fi
echo "The headers, that shadow the system ones, are seen"

